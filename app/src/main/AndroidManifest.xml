<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.linyu.mcx19hook">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="1.9.2" />
        <meta-data
            android:name="xposeddescription"
            android:value="网易我的世界(com.netease.x19) LSPosed功能模块 - 透视/自瞄/飞行/无敌/物品管理/网络包控制" />

        <service
            android:name=".hook.HookService"
            android:enabled="true"
            android:exported="false"
            android:process=":hook" />

        <service
            android:name=".ui.FloatingWindowService"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:theme="@style/Theme.Transparent" />

        <receiver
            android:name=".config.ConfigChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.linyu.mcx19hook.CONFIG_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>